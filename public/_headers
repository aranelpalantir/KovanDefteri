# Uygulama kabugu ve service worker her zaman taze olmali, yoksa
# kullanicilar eski surumde takili kalir.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache, max-age=0

# Paket ve varlik adlari hash'li, sonsuza kadar onbellege alinabilir.
/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800
